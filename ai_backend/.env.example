# AI Backend Environment Variables
ENVIRONMENT=production
PORT=8000
AGENT_DEBUG_MODE=false
AGENT_LOGGING=true

# PostgreSQL Connection (must have pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/dbname

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# AI & LLM Providers
GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key
HF_TOKEN=your_huggingface_token_optional

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Optional custom paths (defaults to ./data/chunks.json and ./data/government_schemes.csv)
# KB_FILE_PATH=/app/data/chunks.json
# CSV_PATH=/app/data/government_schemes.csv

