# Main Backend Environment Variables
ENVIRONMENT=production
PORT=5000

# PostgreSQL Connection (must have pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/dbname

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# AI & LLM Providers
GEMINI_API_KEY=your_gemini_api_key

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Frontend URL (for CORS and reset links)
FRONTEND_URL=http://localhost:5173

# Email Service
EMAIL=your_email@example.com
MAIL_PASSWORD=your_email_app_password
MAIL_FROM_NAME="ArthNiti Support"

# AWS / S3 Storage (Optional)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

